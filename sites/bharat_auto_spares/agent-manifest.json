{
  "brand": "Bharat Auto Spares",
  "networks": [
    {
      "name": "bharat_auto_spares",
      "front_man": "bharat_auto_spares_assistant",
      "hocon": "./bharat_auto_spares.network.json",
      "description": "Ask Bharat Auto Spares what is in stock right now and hold an item for pickup.",
      "tags": [
        "agentified-website",
        "local-shop",
        "auto_parts"
      ],
      "sample_queries": [
        "Do you have part VZ125-CLC-1722?",
        "Do you have a clutch cable for a 2019 Vayu Zip 125?",
        "Hold one A7 spark plug for me.",
        "Are you open now, and where are you?",
        "Can you fit the part for me?"
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.otari.ai/api/v1",
    "mock": false,
    "byok_router": "https://api.otari.ai/api/v1"
  },
  "allowed_peers": [
    "http://[::1]:8085"
  ],
  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Calls only its partner shop in allowed_peers, after the visitor agrees."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "bharat_auto_spares",
    "front_man": "bharat_auto_spares_assistant",
    "available": false,
    "reason": "This is a static bundle; a public MCP facade requires an application host."
  },
  "theme": {
    "primary": "#1d4ed8"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "bharat_auto_spares",
        "front_man": "bharat_auto_spares_assistant",
        "aliases": [
          "bharat_auto_spares",
          "bharat_auto_spares_assistant"
        ],
        "url": "bharat_auto_spares"
      }
    ],
    "imports": [],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  },
  "actions": {
    "version": 1,
    "module": "./site-actions.js",
    "bridge": "./bridge/action-bridge.html",
    "agentTools": [
      "check_stock",
      "get_shop_info",
      "request_hold"
    ]
  }
}
