{
  "brand": "Jeevan Chemist",
  "networks": [
    {
      "name": "jeevan_chemist",
      "front_man": "jeevan_chemist_assistant",
      "hocon": "./jeevan_chemist.network.json",
      "description": "Ask Jeevan Chemist what is in stock right now and hold an item for pickup.",
      "tags": [
        "agentified-website",
        "local-shop",
        "pharmacy"
      ],
      "sample_queries": [
        "Do you have children's paracetamol syrup?",
        "Is amoxicillin 500 mg in stock, and can it be held?",
        "Hold one pack of ORS sachets for me.",
        "Are you open now, and where are you?",
        "What dose of cetirizine should I take?"
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.otari.ai/api/v1",
    "mock": false,
    "byok_router": "https://api.otari.ai/api/v1"
  },
  "allowed_peers": [
    "http://[::1]:8082"
  ],
  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Calls only its partner shop in allowed_peers, after the visitor agrees."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "jeevan_chemist",
    "front_man": "jeevan_chemist_assistant",
    "available": false,
    "reason": "This is a static bundle; a public MCP facade requires an application host."
  },
  "theme": {
    "primary": "#047857"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "jeevan_chemist",
        "front_man": "jeevan_chemist_assistant",
        "aliases": [
          "jeevan_chemist",
          "jeevan_chemist_assistant"
        ],
        "url": "jeevan_chemist"
      }
    ],
    "imports": [],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  },
  "actions": {
    "version": 1,
    "module": "./site-actions.js",
    "bridge": "./bridge/action-bridge.html",
    "agentTools": [
      "check_stock",
      "get_shop_info",
      "request_hold"
    ]
  }
}
